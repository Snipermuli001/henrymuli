# Generate a long random secret. Never commit your real value.
ENGINE_API_TOKEN=replace-with-a-long-random-secret

# Comma-separated origins allowed to call this API from a browser.
# Add your real Cloudflare Pages origin before deployment.
ALLOWED_ORIGINS=https://henrymuli.pages.dev

# Required: only these domains (and their subdomains) may be submitted.
# Example: youtube.com,youtu.be,cdn.example.com
ALLOWED_DOMAINS=youtube.com,youtu.be

# Optional controls
MAX_QUEUE_SIZE=8
MAX_DOWNLOAD_MB=500
JOB_TIMEOUT_SECONDS=900
